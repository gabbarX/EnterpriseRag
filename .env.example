# =====================================================================
# EnterpriseRag environment variable reference
# ---------------------------------------------------------------------
# How to use:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Replace every placeholder with a real value (especially the entries
#      marked REQUIRED)
#   3. Make sure .env is never committed to version control
#
# How configuration is injected:
#   - the app service reads every variable in this file through env_file: .env;
#   - the docreader / mcp / frontend / odl-hybrid services have no env_file and
#     consume only the variables listed explicitly in their own environment
#     block (see docker-compose.yml).
#
# Section order:
#   A. Deployment basics      images, runtime, networking
#   B. Data and storage       database, Redis, file storage, object storage
#   C. Retrieval and graph    vector stores, knowledge graph
#   D. Models                 LLM/VLM/Ollama, built-in models
#   E. Document parsing       Docreader, task timeouts
#   F. Auth and tenancy       JWT/AES, registration, RBAC, OIDC
#   G. Agent and sandbox      Sandbox, Skills, agent timeouts
#   H. Optional integrations  web search, MCP server
#   I. Observability          Langfuse
#   J. Security and tuning    SSRF, proxies, concurrency
# =====================================================================


# #####################################################################
# A. Deployment basics
# #####################################################################

# ========== A1. Image version and build ==========
# EnterpriseRag image tag: latest (stable) / main (newest development build). To pin a fixed version, set the git tag of the target release (for example v0.7.0, note the v prefix) and run docker compose pull to fetch the matching images.
ENTERPRISERAG_VERSION=latest
# Optional Alpine APK mirror host used when building the app image. Leave empty to use upstream defaults.
APK_MIRROR_ARG=
# Whether to link the in-process anydoc parsing engine into the app image (default 1). Set 0 to skip the Rust toolchain and shorten the build; the engine then shows as unavailable on the settings page.
# WITH_ANYDOC=1
# Optional apt mirror host used when building the docreader image. Leave empty to use upstream defaults.
# APT_MIRROR=
# Short commit written into the system information page when the frontend image is built from source.
# make docker-build-frontend and start_all.sh --no-pull fill this in from git automatically; export
# it yourself when running docker compose build directly, otherwise the page shows "unknown".
# VITE_FRONTEND_COMMIT=
# Optional npm registry used when building the frontend image. Leave empty to use the upstream registry.
# NPM_REGISTRY=
# Node heap limit for the Vite build (MB). Lower it to 2048 when Docker Desktop has little memory allocated.
# NODE_MAX_OLD_SPACE_SIZE=4096

# ========== A2. Runtime basics ==========
# gin run mode: debug (development, verbose logs + Swagger) / release (production, Swagger disabled).
GIN_MODE=release
# Log level: debug / info / warn / error / fatal. Default debug.
# LOG_LEVEL=debug
# Log file path (leave empty to log to stdout only); when LLM_DEBUG_LOG is on, llm_debug.log is written to the same directory.
# LOG_PATH=
# Custom log format template (leave empty to use the built-in default format).
# LOG_FORMAT=
# LLM debug log: writes the complete request and response of every model call to a separate file, useful when investigating context problems.
# Accepted values: true (writes llm_debug.log next to LOG_PATH) / false or empty (off) / an explicit file path.
# LLM_DEBUG_LOG=true
# Time zone. Affects displayed system time and log timestamps.
# Common values: Asia/Kolkata, UTC, Europe/London, America/New_York, Asia/Singapore.
TZ=Asia/Kolkata
# Run database migrations automatically at start-up; set false to disable (enabled by default).
AUTO_MIGRATE=true
# Automatically recover a dirty migration state (default true).
AUTO_RECOVER_DIRTY=true
# Promote the user with this email address to system administrator at start-up (idempotent; it only ever PROMOTEs, never DEMOTEs).
# Intended for first-time bootstrap under docker-compose or k8s; later grants and revocations are done from the SystemAdmin management page.
# ENTERPRISERAG_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=
# Optional: if set and the user above does not exist yet, create it with this password (username = email local part) before promoting. Never changes an existing account's password.
# ENTERPRISERAG_BOOTSTRAP_SYSTEM_ADMIN_PASSWORD=

# ========== A3. Networking and external addresses ==========
# Application service hostname, default app (the Docker service name); point it at a remote address when the backend runs elsewhere.
APP_HOST=app
# Host port the application service is published on, default 8080 (affects host access only, not container-to-container traffic).
APP_PORT=8080
# Target port NGINX proxies to, default 8080 (the port the app listens on inside its container).
# Keep the default for a local deployment; set the real port of the remote app service otherwise.
# APP_BACKEND_PORT=8080
# Scheme NGINX uses to reach the backend, default http; set https when the remote backend serves HTTPS.
# APP_SCHEME=http
# Frontend service port, default 80.
FRONTEND_PORT=80
# Docreader address (used by app to reach docreader).
DOCREADER_ADDR=docreader:50051
# Docreader transport: grpc / http / https.
DOCREADER_TRANSPORT=grpc
# External URL of the application (affects image and file links sent to IM channels).
# Set it to the URL of this EnterpriseRag instance as the IM platform or client can reach it, for example https://enterpriserag.example.com.
# For knowledge base images to render inside an IM channel, the IM side must be able to fetch the image over a public http URL. There are two ways to achieve that:
#   (A) the storage backend itself is publicly reachable (object storage with a public endpoint, or
#      MINIO_ENDPOINT pointing at a public host); resource:// then falls back to a presigned backend
#      URL and this variable is not needed.
#   (B) set this variable; resource:// images are rewritten to <APP_EXTERNAL_URL>/r/<token> and served
#      through EnterpriseRag (nginx must proxy /r/).
# The default MinIO deployment (minio:9000 is internal only) is simplest with (B); the local backend can only use (B).
# Private IPs and localhost are not reachable from Slack, Mattermost and similar platforms; for local development use ngrok, cloudflared or frp.
# APP_EXTERNAL_URL=
# External origin of the frontend, used for absolute URLs such as invitation links (leave empty to use host-relative links).
# FRONTEND_BASE_URL=
# Default form of file references in API responses: handle (default) / public.
#   handle — returns the internal resource://<handle>; the client must call the authenticated /files proxy to fetch the image.
#   public — returns a directly loadable http(s) link that a third-party app can render without a second request.
# A single request can override this with ?resource_urls=handle|public; see "API reference" in the README for the scope of that override.
# public needs APP_EXTERNAL_URL above (or a publicly reachable storage backend) to build external links;
# when a link cannot be built the reference stays as resource:// and the client can still fall back to /files.
# Note: public issues a time-limited anonymous read link (2 hours via EnterpriseRag, 24 hours via MinIO) for every referenced file.
# The anonymous embed channel and knowledge-base-scoped API keys are unaffected and always return a handle.
# Configure SYSTEM_AES_KEY as well, so grant rows can be reused, direct URLs stay stable, and read endpoints do less write work.
# RESOURCE_URL_MODE=handle
# Externally exposed MCP server port (default 8082).
# MCP_PORT=8082


# #####################################################################
# B. Data and storage
# #####################################################################

# ========== B1. Database — REQUIRED ==========
# Primary database driver: postgres / sqlite. sqlite is used by Lite mode, see DB_PATH.
DB_DRIVER=postgres
# Database host.
DB_HOST=postgres
# Database port.
DB_PORT=5432
# Database user name.
DB_USER=postgres
# Database password.
DB_PASSWORD=postgres123!@#
# Database name.
DB_NAME=enterpriserag
# Used by the SQLite driver only (DB_DRIVER=sqlite); ignored by the postgres driver.
# DB_PATH=./data/enterpriserag.db

# ========== B2. Redis / stream processing / Asynq queues ==========
# --- Stream processing backend and Redis connection ---
# Stream processing backend: memory / redis. In redis mode the Asynq task queue uses this Redis instance as well.
STREAM_MANAGER_TYPE=redis
# Redis address (leave empty to disable Redis; Lite mode uses memory).
REDIS_ADDR=redis:6379
# Redis user name (Redis 6.0+ ACL, optional).
# REDIS_USERNAME=
# Redis password; leave empty when none is set.
REDIS_PASSWORD=redis123!@#
# Redis database index, default 0.
REDIS_DB=0
# Redis key prefix, used for namespace isolation.
REDIS_PREFIX=stream:
# Suffix for the Redis channel namespace (isolates several deployments sharing one Redis).
# ENTERPRISERAG_REDIS_NAMESPACE=
# Asynq client Redis read/write timeout (milliseconds, default 500; writes can go up to 1000).
# ENTERPRISERAG_REDIS_OP_TIMEOUT_MS=500

# --- Redis TLS (encrypted transport for managed Redis such as AWS ElastiCache; off by default) ---
# Whether to enable TLS.
# REDIS_USE_TLS=false
# Server name used for certificate verification and SNI (useful when the address is an IP).
# REDIS_TLS_SERVER_NAME=
# Skip server certificate verification. Insecure; for development or self-signed certificates only, never in production.
# REDIS_TLS_INSECURE_SKIP_VERIFY=false

# --- Asynq worker concurrency ---
# Each pool is a separate asynq.Server and is hard-isolated; leave empty or set below 1 to use the code default. The value is the guaranteed concurrency per instance, so it adds up across replicas. These can also be tuned at runtime from system settings (asynq.*_concurrency) without a restart. Format: variable = default — queues consumed / notes
# default + chat_attachment (main document parsing path; chat_attachment is weighted higher so it is not starved by bulk imports)
# ENTERPRISERAG_ASYNQ_CORE_CONCURRENCY=8
# postprocess (post-parse knowledge base processing and fan-out; a separate pool so it is not queued behind long DocReader jobs, as it needs low latency)
# ENTERPRISERAG_ASYNQ_POSTPROCESS_CONCURRENCY=2
# summary / multimodal / graph / question (summaries, image multimodal work, graph chunk extraction, question generation; LLM/VLM heavy, tune to your provider budget)
# ENTERPRISERAG_ASYNQ_ENRICHMENT_CONCURRENCY=12
# sync + low (data source sync, FAQ import, KB clone/delete, bulk re-parse, knowledge moves; long running, excluded from shared borrowing)
# ENTERPRISERAG_ASYNQ_MAINTENANCE_CONCURRENCY=4
# Elastic pool that can borrow from the CORE and ENRICHMENT queues (safe via atomic dequeue); it does not consume POSTPROCESS or MAINTENANCE
# ENTERPRISERAG_ASYNQ_SHARED_CONCURRENCY=6
# Dedicated pool for wiki generation (LLM bound, tune to your provider concurrency budget)
# ENTERPRISERAG_WIKI_ASYNQ_CONCURRENCY=8
# Per-model concurrency ceiling for background tasks (0 or negative disables it; interactive chat is not limited by this)
# ENTERPRISERAG_MODEL_MAX_CONCURRENCY=32

# ========== B3. File storage (general) ==========
# File storage type: local / minio / s3 / dummy.
STORAGE_TYPE=local
# Allow list of storage types users may choose (comma separated; leave empty to allow all).
# STORAGE_ALLOW_LIST=local,minio,s3
# Root directory for local storage (used when STORAGE_TYPE=local).
LOCAL_STORAGE_BASE_DIR=/data/files
# Path prefix for local storage (used for legacy backfill, normally left empty).
# LOCAL_STORAGE_PATH_PREFIX=
# Unified file size limit (MB, default 50). Applies to knowledge base and attachment uploads, the docreader gRPC message size, and browser-side knowledge base validation. This is deployment-time configuration: Go, Nginx, docreader and the browser each read it once at start-up, changes do not take effect at runtime, and all four layers must be restarted afterwards.
# MAX_FILE_SIZE_MB=50
# Limit for skill zip uploads and downloads from GitHub / ClawHub sources (MB, default 256). Kept separate from knowledge base uploads because skill bundles such as ppt-master exceed 50MB. A GitHub zipball is measured as the whole repository archive, not the SKILL.md subtree, so a very large repository is still rejected during download. When unset it is never lower than MAX_FILE_SIZE_MB and never higher than 512. Nginx relaxes only POST /api/v1/skills/catalog and POST /api/v1/sandbox-configs/{id}/skills to this value; sub-paths such as /install and PATCH stay at MAX_FILE_SIZE_MB. Restart app and frontend after changing it.
# MAX_SKILL_BUNDLE_SIZE_MB=256

# ========== B4. Object storage provider (pick the one matching STORAGE_TYPE) ==========
# ----- MinIO (STORAGE_TYPE=minio) -----
# MinIO endpoint (host:port). For IM channels this must be a host the IM platform can reach over the public internet (minio:9000 will not work).
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY_ID=your_minio_access_key
# MINIO_SECRET_ACCESS_KEY=your_minio_secret_key
# MINIO_BUCKET_NAME=your_minio_bucket_name
# MINIO_PATH_PREFIX=
# MINIO_USE_SSL=false
# MinIO ports (used by the compose port mapping).
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ----- AWS S3 (STORAGE_TYPE=s3) -----
# S3 endpoint (optional; leave empty to use the standard AWS endpoint for the region.
# The reference deployment region is ap-south-1 (Mumbai), i.e. https://s3.ap-south-1.amazonaws.com)
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_REGION=ap-south-1
# Access key and secret key. Leave both empty to use the AWS SDK default credential chain, which
# supports EC2/ECS/EKS IAM roles, IRSA / web identity, environment variables and shared config files.
# Either fill in both or leave both empty.
# S3_SECRET_KEY=your_s3_secret_key
# S3_ACCESS_KEY=your_s3_access_key
# S3_BUCKET_NAME=your_s3_bucket_name
# S3_PATH_PREFIX=enterpriserag/
# S3_USE_SSL=true
# S3_FORCE_PATH_STYLE=false


# #####################################################################
# C. Retrieval and knowledge graph
# #####################################################################

# ========== C1. Vector store / retrieval engine ==========
# Vector store type (comma separated to use several drivers): postgres / sqlite /
# elasticsearch_v7 / elasticsearch_v8 / opensearch / qdrant / milvus / weaviate.
RETRIEVE_DRIVER=postgres
# Timeout for parallel retrieval across several vector stores (seconds; applies when RETRIEVE_DRIVER lists more than one driver).
# MULTI_STORE_RETRIEVE_TIMEOUT_SEC=
# ----- Elasticsearch v7/v8 -----
# ELASTICSEARCH_ADDR=http://localhost:9200
# ELASTICSEARCH_USERNAME=your_elasticsearch_username
# ELASTICSEARCH_PASSWORD=your_elasticsearch_password
# ELASTICSEARCH_INDEX=enterpriserag
# ----- OpenSearch (the dev compose file ships a single-node profile) -----
# OPENSEARCH_ADDR=http://opensearch:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INSECURE_SKIP_VERIFY=false
# OPENSEARCH_INDEX=enterpriserag
# ----- Qdrant -----
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# QDRANT_REST_PORT=6333
# QDRANT_COLLECTION=enterpriserag_embeddings
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_USE_TLS=false
# ----- Milvus -----
# MILVUS_ADDRESS=milvus:19530
# MILVUS_COLLECTION=enterpriserag_embeddings
# MILVUS_METRIC_TYPE=IP          # IP (default) / COSINE / L2; changing it requires rebuilding the collection.
# Newly created collections configure multi-language analyzers on the content field.
# For an older collection, first run go run ./cmd/milvus-migrate (the metric of the source
# collection is retained), then point MILVUS_COLLECTION at the new prefix; do not change MILVUS_METRIC_TYPE.
# MILVUS_USERNAME=your_milvus_username
# MILVUS_PASSWORD=your_milvus_password
# MILVUS_DB_NAME=your_milvus_db_name
# ----- Weaviate -----
# From inside a container use service:port (not localhost or the host-mapped port).
# WEAVIATE_HOST=weaviate:8080
# WEAVIATE_GRPC_ADDRESS=weaviate:50051
# WEAVIATE_SCHEME=http
# WEAVIATE_AUTH_ENABLED=false    # Set true only when APIKey/OIDC is enabled, then also set WEAVIATE_API_KEY.
# WEAVIATE_API_KEY=your_secret_key
# WEAVIATE_COLLECTION=your_weaviate_db_name

# ========== C2. Knowledge graph (Neo4j, optional) ==========
# The single global switch for the knowledge graph. Anything other than true disables graph building and graph retrieval (building calls the LLM and takes a long time).
# Note: ENABLE_GRAPH_RAG was replaced by NEO4J_ENABLE in v0.1.6; the Go application no longer reads it and it has been removed.
# NEO4J_ENABLE=false
# Neo4j connection URI. bolt:// connects directly to a single instance (recommended, no routing overhead); neo4j:// uses cluster routing discovery (it works against a single instance too, but adds a discovery round trip).
# EnterpriseRag deploys a single Neo4j instance by default, hence bolt://.
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password


# #####################################################################
# D. Models
# #####################################################################

# ========== D1. LLM / VLM / Ollama ==========
# Only warn instead of failing when Ollama is unavailable (applies when true; the default is not to block, so start-up does not fail when Ollama is not configured).
OLLAMA_OPTIONAL=true
# Base URL of the Ollama service (local or remote Ollama).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Batch size for embedding calls (leave empty to use the code default).
# BATCH_EMBED_SIZE=
# Timeout for a single VLM HTTP request (seconds, default 180; raise it when a slow endpoint reports "context deadline exceeded").
# VLM_HTTP_TIMEOUT_SECONDS=180
# Raw dump of the LLM stream (for investigating context problems; 1 enables it, the default directory is ~/.enterpriserag/investigate/llm-stream).
# ENTERPRISERAG_LLM_STREAM_RAW_DUMP=
# ENTERPRISERAG_LLM_STREAM_RAW_DUMP_DIR=

# ========== D2. Declarative built-in model configuration (optional) ==========
# Once config/builtin_models.yaml is enabled (see config/builtin_models.yaml.example), the
# ${NAME} placeholders in that YAML are resolved from these variables at application start-up.
# The variable names are yours to choose in the YAML; the common ones are listed below for reference.
#
# Built-in chat model
# LLM_MODEL_NAME=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=openai
#
# Built-in embedding model
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# Built-in rerank model
# RERANK_MODEL_NAME=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_PROVIDER=generic


# #####################################################################
# E. Document parsing
# #####################################################################

# ========== E1. Docreader gRPC and general parsing ==========
# ----- gRPC server TLS / authentication (shared by docreader and app; client and server must use the same values) -----
# Enable TLS encryption for gRPC. Default false (docreader is only called by app over the internal compose network, so plaintext is acceptable).
# GRPC_TLS_ENABLED=false
# Server certificate, or client certificate when using mTLS. Required when the server has TLS on.
# GRPC_TLS_CERT=/path/to/server.crt
# Private key for that certificate.
# GRPC_TLS_KEY=/path/to/server.key
# CA certificate: used by the client to verify the server certificate, and by the server under mTLS as the CA that issued the client certificates.
# GRPC_TLS_CA=/path/to/ca.crt
# TLS SNI / certificate verification name. Set it to the hostname in the certificate when DOCREADER_ADDR is an IP or does not match the certificate CN.
# GRPC_TLS_SERVER_NAME=
# Server side: when true, clients must present a certificate (mutual TLS / mTLS).
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false
# Per-RPC gRPC authentication token (client and server must match). Enabling TLS alongside it is strongly
# recommended, otherwise the token travels in plaintext with every RPC; when GRPC_TLS_ENABLED=true the
# client refuses to send the token over an insecure connection.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
# ----- gRPC service parameters -----
# Maximum number of concurrent workers in the gRPC server (default 4).
# DOCREADER_GRPC_MAX_WORKERS=4
# Maximum size of a single gRPC message (MB, default 50). Normally follows MAX_FILE_SIZE_MB; very large scanned images can exceed it.
# DOCREADER_GRPC_MAX_FILE_SIZE_MB=50
# gRPC listen port (default 50051). Rarely needs changing, and must match the docreader port in docker-compose.
# DOCREADER_GRPC_PORT=50051
# ----- General parsing -----
# Maximum number of DOCX pages to parse (default 0 = unlimited). Set a positive value such as 500 to cap the cost of parsing very large Word documents.
# DOCREADER_DOCX_MAX_PAGES=0
# Number of concurrent workers for MarkItDown (a heavy parser). 0 disables throttling; the default of 1 suits a single machine or limited GPU.
# DOCREADER_MARKITDOWN_MAX_WORKERS=1
# Outbound HTTP/HTTPS proxy (used when fetching web pages or remote images).
# DOCREADER_EXTERNAL_HTTP_PROXY=
# DOCREADER_EXTERNAL_HTTPS_PROXY=

# ========== E2. OpenDataLoader hybrid (optional; selected by a knowledge base whose parser_engine_rules sets engine: opendataloader) ==========
# Concurrency of the ODL heavy parser (default 1).
# DOCREADER_ODL_MAX_WORKERS=1
# Hybrid mode switch: off (default, plain fast local parsing) / docling-fast and similar (needs the separate odl-hybrid container).
# DOCREADER_ODL_HYBRID=off
# Address of the odl-hybrid service. The code default is http://127.0.0.1:5002; docker compose injects http://odl-hybrid:5002.
# DOCREADER_ODL_HYBRID_URL=http://odl-hybrid:5002
# Hybrid mode selection (auto). Rarely needs changing.
# DOCREADER_ODL_HYBRID_MODE=auto
# Whether to fall back to fast mode when hybrid parsing fails (default false).
# DOCREADER_ODL_HYBRID_FALLBACK=false
# Whether the markdown produced by hybrid mode keeps inline HTML (default false).
# DOCREADER_ODL_MARKDOWN_WITH_HTML=false
# ----- odl-hybrid container parameters (used only with --profile odl-hybrid) -----
# Extra arguments passed to odl-hybrid. The default --no-ocr suits digital PDFs; use --force-ocr for scanned documents (requires EasyOCR and libGL).
# ODL_HYBRID_EXTRA_ARGS=--no-ocr
# Published port of odl-hybrid (used by the dev compose mapping).
# ODL_HYBRID_PORT=5002
# Maximum time app waits at start-up for odl-hybrid to become ready (seconds).
# ODL_HYBRID_STARTUP_WAIT_SEC=180

# ========== E3. PDF rendering ==========
# Number of PDF render workers (concurrency across documents, default 1).
# DOCREADER_PDF_RENDER_MAX_WORKERS=1
# Number of parallel processes used to render scanned pages within a single PDF (pdfium is not thread safe, so parallelism is per process). The default is min(4, cpu). Rendering a large scanned document serially can take hours on a CPU-limited container, and raising this shortens it considerably (measured: 874 pages, 117s -> 30s with 4 processes -> 17s with 8). The container needs enough CPU allocated to benefit.
# DOCREADER_PDF_RENDER_PARALLELISM=4
# Render DPI (default 200).
# DOCREADER_PDF_RENDER_DPI=200
# JPEG quality of rendered images (default 85).
# DOCREADER_PDF_JPEG_QUALITY=85
# Maximum long-edge pixel size of a rendered page image (default 2000). Prevents very large pages from producing 100+ MP images that blow past the gRPC message limit; lowering it shrinks images further, but too small a value hurts OCR accuracy (keep it >= 1600 for dense text).
# DOCREADER_PDF_RENDER_MAX_EDGE=2000

# ========== E4. Scanned PDF detection and overrides ==========
# Force every PDF page to be parsed as a scan (rendered to an image and then sent through OCR/VLM). Useful for PDFs with a poor text layer but OCR-able pages; it increases both time and model call cost. Default false (the thresholds below decide automatically).
# DOCREADER_PDF_FORCE_SCANNED=false
# Automatic detection: a page whose image objects cover at least this fraction of the area counts as a scanned page (default 0.5).
# DOCREADER_PDF_SCAN_IMAGE_RATIO=0.5
# Automatic detection: a page with fewer characters than this is treated as having no usable text layer (default 10).
# DOCREADER_PDF_SCAN_MIN_CHARS=10

# ========== E5. PDF layout / text extraction (native text pages) ==========
# Layout-aware text extraction: reconstructs a readable reading order (default true).
# DOCREADER_PDF_LAYOUT_ORDERING=true
# When glyphs carry no explicit space positioning (common in OCR or searchable text), insert a space once the gap exceeds this multiple of the median character width (default 0.4).
# DOCREADER_PDF_WORD_GAP_WIDTH_RATIO=0.4
# Page-width ratio below which a narrow side column (arXiv sidebar watermarks, page number labels) is discarded (default 0.12).
# DOCREADER_PDF_MARGIN_COL_WIDTH_RATIO=0.12
# Minimum number of characters a line needs before the font-size heuristic may promote it to a markdown heading (default 8).
# DOCREADER_PDF_MIN_HEADING_LINE_CHARS=8
# Promote visually larger lines to markdown headings (rect height is used as a proxy for font size, default true).
# DOCREADER_PDF_DETECT_HEADINGS=true
# Drop invisible text (render mode 3), off-page text and degenerate text, to prevent hidden-text injection (default true).
# DOCREADER_PDF_FILTER_HIDDEN_TEXT=true
# Clean up pdfium placeholders (U+FFFE) and soft hyphens, and strip axis and legend text from vector graphics (default true).
# DOCREADER_PDF_SANITIZE_TEXT=true
# Strip fragmented text from chart areas (works together with SANITIZE_TEXT, default true).
# DOCREADER_PDF_STRIP_CHART_DEBRIS=true

# ========== E6. Embedded image extraction from PDFs (native text pages) ==========
# Extract embedded bitmaps from native pages so the VLM/OCR can analyse them (default true).
# DOCREADER_PDF_EXTRACT_EMBEDDED_IMAGES=true
# Minimum pixel width and height an embedded image must have to be kept (default 80; smaller images are discarded).
# DOCREADER_PDF_EMBED_MIN_PIXELS=80
# Minimum fraction of the page area an embedded image must cover to be kept (default 0.01).
# DOCREADER_PDF_EMBED_MIN_AREA_RATIO=0.01
# When the same image appears on at least this fraction of the text pages it is treated as a running header or footer and de-duplicated (default 0.5).
# DOCREADER_PDF_EMBED_REPEAT_PAGE_FRAC=0.5
# Hard cap on the number of embedded images extracted per document (default 50).
# DOCREADER_PDF_EMBED_MAX_IMAGES=50

# ========== E7. Chart region detection in PDFs (vector graphics areas) ==========
# Render detected vector chart regions (those with no embedded bitmap) to JPEG for the VLM/OCR (default true).
# DOCREADER_PDF_RENDER_VECTOR_FIGURES=true
# Minimum characters per line a region needs before it is treated as a chart (default 18).
# DOCREADER_PDF_MIN_CHART_REGION_CHARS=18
# Minimum area fraction a region needs before it is treated as a chart (default 0.015).
# DOCREADER_PDF_MIN_CHART_REGION_AREA=0.015
# Maximum area fraction a region may have and still be treated as a chart (default 0.42).
# DOCREADER_PDF_MAX_CHART_REGION_AREA=0.42
# Maximum fraction of the page height a figure may occupy and still count as a standalone chart (default 0.38).
# DOCREADER_PDF_MAX_FIGURE_HEIGHT_RATIO=0.38

# ========== E8. Document processing / task timeouts ==========
# Overall timeout for processing one document (Go duration, default 2h; raise it for large files).
# ENTERPRISERAG_DOCUMENT_PROCESS_TIMEOUT=2h
# Timeout for a single DocReader RPC (default 30m; must be smaller than the value above).
# ENTERPRISERAG_DOCREADER_CALL_TIMEOUT=30m
# Knowledge base housekeeping sweep (reclaims dirty records stuck in processing; false disables it, which is not recommended).
# ENTERPRISERAG_HOUSEKEEPING_ENABLED=true
# How long parsed chat attachment output is retained (hours, default 24).
# ENTERPRISERAG_CHAT_ATTACHMENT_TTL_HOURS=24
# Maximum time a single question waits for attachment parsing to finish (seconds, default 60; raise it for large or scanned files).
# ENTERPRISERAG_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60
# VLM OCR tuning for attachments (scanned or image-heavy documents): concurrency and page cap.
# ENTERPRISERAG_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# ENTERPRISERAG_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# #####################################################################
# F. Authentication and tenant isolation
# #####################################################################

# ========== F1. Secrets — REQUIRED (always change the defaults in production) ==========
# JWT signing secret, used for frontend login and token refresh (a random one is generated at start-up when left empty).
# Generate once: openssl rand -hex 32
JWT_SECRET=
# AES-256 master key, used to encrypt sensitive fields such as API keys at rest (must be 32 bytes).
# It covers tenants.api_key, model API keys, vector store credentials, web search provider keys,
# provider AppSecret and similar fields. If it is missing or the wrong length, already encrypted
# fields cannot be decrypted (the UI shows them as empty and they must be re-entered).
# In production it must be set explicitly and kept safe; if it is lost, no encrypted data can be recovered.
# Note: TENANT_AES_KEY / CRYPTO_MASTER_KEY / CRYPTO_SALT are deprecated. CryptoService (PBKDF2) was removed in v0.4.0 and encryption now uses SYSTEM_AES_KEY throughout. The Go application no longer reads those three variables and they have been removed.
# Generate once: openssl rand -hex 16 (32 ASCII bytes); retain existing keys on upgrade.
SYSTEM_AES_KEY=
# Optional independent signing key for embed sessions and presigned URLs.
# Generate once: openssl rand -hex 32. Falls back to a valid SYSTEM_AES_KEY.
SYSTEM_SIGNING_KEY=

# ========== F2. Registration and workspace policy ==========
# Block new user registration (recommended true in production).
# DISABLE_REGISTRATION=false
# When enabled, passwords must contain upper case and lower case letters, digits and a special character from: !@#$%^&*()_+-=[]{}|;:,.<>?
# ENTERPRISERAG_AUTH_COMPLEX_PASSWORD_ENABLED=false
# Default workspace policy after public registration: create_personal (default, creates a personal workspace automatically) / tenantless.
# ENTERPRISERAG_AUTH_DEFAULT_TENANT_MODE=create_personal
# Whether ordinary users may create workspaces themselves after logging in (default true; when false they can only join by invitation, system administrators are unaffected).
# ENTERPRISERAG_TENANT_SELF_SERVICE_CREATION_ENABLED=true
# Enable workspace-level RBAC (true enforces authorisation by default; false is observe mode, in which in-workspace role checks are logged but not blocked — cross-workspace access is always blocked).
# ENTERPRISERAG_TENANT_ENABLE_RBAC=true
# Enable cross-workspace access (requires the user's CanAccessAllTenants permission; default false). A cross-workspace administrator currently has to be granted that permission by editing the database directly.
# ENTERPRISERAG_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
# Maximum number of workspaces a single non-superadmin user may create (greater than 0 enforces the quota; 0 uses the default; a negative value disables the quota).
# ENTERPRISERAG_TENANT_MAX_OWNED_PER_USER=
# Whether creating a workspace also generates a full_access API key and returns the token in the response (default false; a compatibility switch for the older behaviour).
# ENTERPRISERAG_TENANT_AUTO_CREATE_API_KEY=false
# Default storage quota for a new workspace (GB, default 10).
# ENTERPRISERAG_TENANT_DEFAULT_STORAGE_QUOTA_GB=10
# TTL of a workspace invitation link (Go duration, default 168h = 7 days).
# ENTERPRISERAG_INVITATION_TTL=168h
# Global switch: add an already registered user to the workspace straight away when inviting them. Default false; it can also be changed on the system settings page.
# ENTERPRISERAG_TENANT_AUTO_ACCEPT_INVITATION=false
# Audit log retention in days (0 disables clean-up, default 90).
# ENTERPRISERAG_AUDIT_RETENTION_DAYS=90

# ========== F3. OIDC authentication (optional, enabled with OIDC_AUTH_ENABLE=true) ==========
# OIDC_AUTH_ENABLE=false
# OIDC_AUTH_ISSUER_URL=http://127.0.0.1:5556/dex
# OIDC_AUTH_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration
# OIDC_AUTH_PROVIDER_DISPLAY_NAME=OIDC
# OIDC_AUTH_CLIENT_ID=client_id_for_oidc_client
# OIDC_AUTH_CLIENT_SECRET=secret_for_oidc_client
# The endpoints below can be left empty once OIDC_AUTH_DISCOVERY_URL is set. Even when the authorization
# and token endpoints are given explicitly, discovery still runs to fill in the blanks whenever jwks_uri
# or issuer is empty, so that the id_token can be validated.
# OIDC_AUTH_AUTHORIZATION_ENDPOINT=http://127.0.0.1:5556/dex/auth
# OIDC_AUTH_TOKEN_ENDPOINT=http://127.0.0.1:5556/dex/token
# OIDC_AUTH_USER_INFO_ENDPOINT=http://127.0.0.1:5556/dex/userinfo
# OIDC_AUTH_JWKS_URI=http://127.0.0.1:5556/dex/keys
# OIDC_AUTH_SCOPES="openid profile email"
# The workspace policy applied when an OIDC user is auto-provisioned on first login is shared with local registration via ENTERPRISERAG_AUTH_DEFAULT_TENANT_MODE; there is no separate setting.
# OIDC_USER_INFO_MAPPING_USER_NAME=name
# OIDC_USER_INFO_MAPPING_EMAIL=email


# #####################################################################
# G. Agent and sandbox
# #####################################################################

# ========== G1. Agent Skills sandbox ==========
# The sandbox backend, credentials, templates, timeouts and private-network access policy are all
# maintained per workspace under Settings -> Sandbox backends. The only deployment-level switch is
# the Docker backend: it is off by default, because access to the local docker.sock is equivalent
# to root on the host. Set it to true when a self-hosted single-machine deployment needs it, or have
# a system administrator enable it under Settings -> System settings -> Network security (effective
# immediately, no restart needed).
ENTERPRISERAG_SANDBOX_DOCKER_ENABLED=false
# The hosted MicroVM sandbox runtime was removed from this distribution. Its adapter is retained so the
# configuration shape and every caller keep working, but it reports "sandbox: no execution runtime configured"
# on every operation. Leave this false unless a replacement runtime has been wired in.
ENTERPRISERAG_SANDBOX_ENABLED=false
# Multi-instance deployments should still configure the shared REDIS_ADDR so the session-to-sandbox binding is shared.

# Default timeout for agent LLM calls (seconds, default 120; raise it to 300 or 600 for complex reasoning).
# Note: this is the global default; an agent with its own llm_call_timeout in the database wins.
# ENTERPRISERAG_AGENT_LLM_TIMEOUT=300
# Timeout while waiting for manual approval of an MCP tool call (seconds, default 600; Go durations such as 30s/5m/1h are accepted).
# ENTERPRISERAG_AGENT_TOOL_APPROVAL_TIMEOUT=600
# Whether an MCP tool call is allowed through when manual approval fails (true allows it; the default is fail-closed and denies it).
# ENTERPRISERAG_AGENT_TOOL_APPROVAL_FAIL_OPEN=


# #####################################################################
# H. Optional integrations
# #####################################################################

# ========== H1. Web search (SearXNG / Tavily) ==========
# ===== SearXNG (optional self-hosted web search) =====
# Enable it with: `docker compose --profile searxng up -d`.
# When SEARXNG_SECRET is unset, the hard-coded default in docker-compose is used, which is fine for a
# local or loopback deployment; if you change SEARXNG_BIND=0.0.0.0 and expose the instance to the LAN
# or the internet, always generate a secret with openssl rand -hex 32 and set SEARXNG_SECRET
# explicitly, otherwise anyone can use the default to sign image-proxy URLs.
#
# Reaching it from the backend (containerised deployment): choose provider type "SearXNG" in the
# console and set the instance URL to http://searxng:8080; docker compose already injects the searxng
# hostname into SSRF_WHITELIST_EXTRA, so nothing else is needed.
#
# Local development (go run + docker compose -f docker-compose.dev.yml --profile searxng up):
# the backend runs on the host and must use the published port, so set the instance URL to
# http://127.0.0.1:8888 and add 127.0.0.1 to SSRF_WHITELIST below.
#
# By default the port listens on 127.0.0.1 only, so an instance running with limiter:false is not
# exposed to the LAN. To open it up to an internal network, override SEARXNG_BIND=0.0.0.0 explicitly
# and harden it yourself.
# SEARXNG_PORT=8888
# Do not set SEARXNG_PORT to the same value as APP_PORT (default 8080).
# On Linux, binding SearXNG to 127.0.0.1:8080 while the app also publishes
# :8080 makes localhost:8080 hit SearXNG first — POST /api/v1/auth/login
# then returns SearXNG's HTML 404 even though DISABLE_REGISTRATION only
# closes registration (see discussion on issue #3296). Keep SearXNG on 8888
# (or another free port).
# SEARXNG_BIND=127.0.0.1
# SEARXNG_SECRET=
# Tavily Search API key (optional, enables the Tavily web search provider).
# TAVILY_API_KEY=tvly-your_tavily_api_key

# ========== H2. MCP server (optional, started with --profile full) ==========
# API key the MCP server uses to call the EnterpriseRag REST API (generate one under Settings -> API Keys in the frontend).
# ENTERPRISERAG_API_KEY=
# Required for HTTP/SSE transport: mcp-server refuses to start without it (clients send it as Authorization: Bearer).
# MCP_SERVER_AUTH_TOKEN=
# Read timeout for calls to the EnterpriseRag REST API (seconds, default 300).
# ENTERPRISERAG_CHAT_TIMEOUT=300
# Whether to verify the TLS certificate of the EnterpriseRag backend (default true; set false for a self-signed certificate).
# ENTERPRISERAG_VERIFY_SSL=true
# Allow list of directories that may be uploaded from (comma separated; leave empty to disable the file upload tool).
# MCP_ALLOWED_UPLOAD_DIRS=


# #####################################################################
# I. Observability (Langfuse, optional)
# #####################################################################

# ========== I1. Langfuse integration (traces chat/embedding/rerank/VLM/ASR model calls and tracks token usage) ==========
#
# Option A: use Langfuse Cloud (simplest)
#   1) Sign in at https://cloud.langfuse.com and generate an API key
#   2) Fill in PUBLIC_KEY / SECRET_KEY below
#   3) docker compose up -d app
#
# Option B: self-host Langfuse (LAN or air-gapped environments)
#   1) Start the self-hosted stack: docker compose --profile langfuse up -d
#      On the first start the ClickHouse migration takes 1-2 minutes; wait for langfuse-web to become healthy
#   2) Open http://localhost:3000, register an administrator account and generate an API key
#   3) Uncomment LANGFUSE_HOST=http://langfuse-web:3000 below and fill in the new PUBLIC_KEY / SECRET_KEY
#   4) docker compose up -d app
#
# Setting PUBLIC_KEY and SECRET_KEY together enables it automatically; no explicit switch is needed.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://langfuse-web:3000
# For the self-hosted stack set: LANGFUSE_HOST=http://langfuse-web:3000
# Optional: explicit switch (true/false; by default it is inferred from the keys).
# LANGFUSE_ENABLED=true
# Optional: release and environment tags, handy for filtering in the Langfuse UI.
# LANGFUSE_RELEASE=v0.4.2
# LANGFUSE_ENVIRONMENT=production
# Optional: batching and sampling policy (for high-traffic production, raise FLUSH_AT and lower SAMPLE_RATE).
# LANGFUSE_FLUSH_AT=15
# LANGFUSE_FLUSH_INTERVAL=3s
# LANGFUSE_QUEUE_SIZE=2048
# LANGFUSE_REQUEST_TIMEOUT=10s
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# ========== I2. Self-hosted Langfuse stack (needed only with --profile langfuse) ==========
# Design note: to keep resource usage low, the self-hosted Langfuse stack **reuses** EnterpriseRag's existing services:
#   - postgres: a separate "langfuse" database is created (once, by the langfuse-db-init container)
#   - redis   : a separate Redis DB index is used (default 1; EnterpriseRag uses 0)
# Only three long-running containers are actually added: langfuse-web, langfuse-worker, langfuse-clickhouse
#                         + 1 dedicated S3: langfuse-minio
#                         + 1 one-shot init: langfuse-db-init
# Published port of the Langfuse web UI.
# LANGFUSE_WEB_PORT=3000
# Ports of the dedicated Langfuse MinIO (kept off 9000/9001 to avoid clashing with EnterpriseRag's main MinIO).
# LANGFUSE_MINIO_S3_PORT=9100
# LANGFUSE_MINIO_CONSOLE_PORT=9101
# External endpoint for media uploads (the browser talks to the Langfuse MinIO directly); defaults to the host-mapped port 9100.
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9100
# Name of the Langfuse database created inside EnterpriseRag-postgres.
# LANGFUSE_DB_NAME=langfuse
# Redis DB index used inside EnterpriseRag-redis (1-15; must not clash with EnterpriseRag's 0).
# LANGFUSE_REDIS_DB=1
# Credentials for ClickHouse and the dedicated Langfuse MinIO (always change these in production).
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_USER=langfuseminio
# LANGFUSE_MINIO_PASSWORD=langfuseminiosecret
# Core Langfuse security fields; regenerate all of them for production:
#   LANGFUSE_SALT=$(openssl rand -base64 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_TELEMETRY_ENABLED=false
# Optional: automate the first start (filling these in provisions the administrator and project directly and skips UI registration).
# LANGFUSE_INIT_ORG_ID=EnterpriseRag
# LANGFUSE_INIT_ORG_NAME=EnterpriseRag
# LANGFUSE_INIT_PROJECT_ID=EnterpriseRag
# LANGFUSE_INIT_PROJECT_NAME=EnterpriseRag
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-enterpriserag-init
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-enterpriserag-init
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=change-me-please


# #####################################################################
# J. Security and deployment tuning
# #####################################################################

# ========== J1. SSRF protection ==========
# SSRF validation allow list (optional). Comma separated; each entry may be an exact domain
# (api.internal), a wildcard domain (*.example.com), an IPv4 address (203.0.113.5), an IPv6 address
# (2001:db8::1, without brackets) or a CIDR block (10.0.0.0/8, 2001:db8::/32).
# Listed entries bypass the usual SSRF rules during URL validation, so configure this carefully in production.
# SSRF_WHITELIST=internal.service,*.corp.example,172.16.0.0/12,2001:db8::1,fd00::/8
#
# ===== SSRF validation of vector store addresses =====
# Addresses are SSRF-validated when a vector store connection is created or tested through the API.
# The services bundled with docker-compose (qdrant, milvus, weaviate, searxng, minio) are already
# allowed through SSRF_WHITELIST_EXTRA by default.
# If you use an external private address or a blocked port (5432, 9200 and so on), add the host to
# SSRF_WHITELIST_EXTRA. Note that overriding the variable replaces the compose default, so the
# built-in service names have to be repeated, for example:
#   SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,minio,my-opensearch.internal
#
# Local development (go run + docker-compose.dev.yml --profile opensearch): the backend runs on the
# host and reaches OpenSearch through the published port http://localhost:9200. Before creating that
# vector store through the API, add localhost to SSRF_WHITELIST (9200 is a blocked port and localhost
# is a restricted hostname):
#   SSRF_WHITELIST=localhost
# Allow list of image hosts whose original URLs are preserved (optional, comma separated). Images from
# these hosts are still downloaded and analysed (OCR, captioning), but the markdown keeps the original
# URL instead of rewriting it to a provider:// object storage URL.
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# ========== J2. Proxies and concurrency ==========
# CIDR blocks of proxies gin should trust (comma separated). By default loopback and private ranges are
# trusted, which covers the nginx container inside the compose network.
# Setting it to an empty string disables proxy trust entirely (ClientIP then returns the direct peer).
# Fill it in explicitly when deploying behind several proxy layers in production.
# ENTERPRISERAG_TRUSTED_PROXIES=
# Size of the ants goroutine pool (embedding concurrency; lower it if you see HTTP 429s).
CONCURRENCY_POOL_SIZE=5

# ========== J3. BrowserSkill local browser (optional) ==========
# Users connect through a Chrome extension.
# The Docker app image already bundles bsk and the matching extension, and by default derives the connection address from the user's current page, so PUBLIC_URL needs no configuration.
# A native deployment additionally needs the build artefacts and the two file paths below; setting BROWSERSKILL_BINARY= explicitly turns the feature off.
# Absolute path to the official bsk executable for the backend's OS and architecture (preset in Docker, no need to configure it again).
# BROWSERSKILL_BINARY=/opt/enterpriserag/browserskill/bsk
# Optional override: only needed for unusual deployments where the gateway uses a separate domain or path. A remote deployment must use WSS, including on an internal network.
# BROWSERSKILL_PUBLIC_URL=wss://enterpriserag.example.com/api/v1/local-browser/extension
# One daemon is shared per application instance; this is the maximum number of user pairing records kept (default 32, not a measured capacity figure).
# BROWSERSKILL_MAX_CONNECTIONS=32
# The companion extension ZIP offered for download in personal settings (absolute path on the server, preset in Docker).
# BROWSERSKILL_EXTENSION_PATH=/opt/enterpriserag/browserskill/browser-skill-enterpriserag-0.3.0.zip
# Multi-replica deployments: give each node an address the other nodes can reach directly, not the load balancer address.
# BROWSERSKILL_INTERNAL_URL=http://10.0.0.12:8080
# All replicas must share the same random secret (at least 32 characters), injected from a secret store and never committed to the repository.
# BROWSERSKILL_CLUSTER_SECRET=
