[Unit]
Description=EnterpriseRag (docker compose)
Requires=docker.service enterpriserag-firstboot.service
After=docker.service network-online.target enterpriserag-firstboot.service
Wants=network-online.target
# Important: Requires=enterpriserag-firstboot.service keeps this service from starting when the
# first-boot init fails, which prevents postgres initialising its data volume with the
# plaintext default password from .env.example before firstboot has generated the random
# secrets. On an already-initialised instance, enterpriserag-firstboot.service is skipped via
# ConditionPathExists=!/opt/EnterpriseRag/.firstboot.done; a skip counts as success and does not block restarts of this service.

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/EnterpriseRag
ExecStart=@DOCKER_BIN@ compose up -d
ExecStop=@DOCKER_BIN@ compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
