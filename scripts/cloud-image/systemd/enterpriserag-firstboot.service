[Unit]
Description=EnterpriseRag first-boot initialization (runs once)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
Before=enterpriserag.service
ConditionPathExists=/usr/local/sbin/enterpriserag-firstboot.sh
ConditionPathExists=!/opt/EnterpriseRag/.firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/enterpriserag-firstboot.sh
RemainAfterExit=no
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
