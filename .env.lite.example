# EnterpriseRag Lite configuration template
# Copy this file to .env.lite and adjust as needed:
#   cp .env.lite.example .env.lite

GIN_MODE=debug

# Log level. One of: debug, info, warn, error, fatal
LOG_LEVEL=debug

# Optional absolute path for the log file. When unset, the macOS .app writes to
# ~/Library/Logs/EnterpriseRag Lite/EnterpriseRag Lite.log
# LOG_PATH=/absolute/path/to/enterpriserag-lite.log

# === Database ===
# Inside the macOS .app, a relative path is redirected to
# ~/Library/Application Support/EnterpriseRag Lite/data/
DB_DRIVER=sqlite
DB_PATH=./data/enterpriserag.db

# === Retrieval engine (FTS5 + sqlite-vec) ===
RETRIEVE_DRIVER=sqlite

# === File storage ===
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=./data/files

# === Stream manager (in-memory, no Redis) ===
STREAM_MANAGER_TYPE=memory

# === LLM services ===
# Local Ollama service. This is the default address; change it if yours differs.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Uncomment these to use another OpenAI-compatible service instead:
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Security (change these before running in production) ===
# Native desktop generates and persists its signing key automatically.
# For encrypted credential storage, generate once: openssl rand -hex 16
SYSTEM_AES_KEY=
JWT_SECRET=

# === Feature switches ===
NEO4J_ENABLE=false
ENABLE_GRAPH_RAG=false
DISABLE_REGISTRATION=false
# Optional allow list of image hosts whose original URL is kept as-is.
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# === Langfuse observability (optional) ===
# Traces the prompt, response and token usage of chat / embedding / rerank /
# VLM / ASR calls. It switches on automatically once both PUBLIC_KEY and
# SECRET_KEY are set.
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# === Performance ===
CONCURRENCY_POOL_SIZE=3

# How long parsed chat attachments are retained, in hours. Default 24.
# ENTERPRISERAG_CHAT_ATTACHMENT_TTL_HOURS=24

# How long a single turn waits for attachment parsing to finish, in seconds.
# Attachments still unparsed when it expires are skipped. Raise it when large
# files or scanned documents parse slowly. Default 60. An agent's own
# "attachment parse wait timeout", when greater than 0, wins over this global.
# ENTERPRISERAG_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60

# VLM OCR tuning for attachments (scanned or image-only documents). The
# bottleneck is per-page VLM OCR, not the document parser.
# OCR_CONCURRENCY is how many pages are OCR'd in parallel (default 8, matching
# the page cap so a scanned document finishes in one pass). Raising it loads the
# VLM backend harder, and every agent shares that backend, so it stays global.
# OCR_MAX_PAGES is the maximum number of pages of a scanned document sent to the
# VLM (default 8). An agent's own "scanned document OCR page limit", when
# greater than 0, wins over this global.
# ENTERPRISERAG_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# ENTERPRISERAG_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# Docreader address
DOCREADER_ADDR=127.0.0.1:50051

# Docreader transport
DOCREADER_TRANSPORT=grpc

# gRPC TLS configuration (optional)
# GRPC_TLS_ENABLED=false
# GRPC_TLS_CERT=/path/to/server.crt           # server: required; client: only for mTLS
# GRPC_TLS_KEY=/path/to/server.key            # as above
# GRPC_TLS_CA=/path/to/ca.crt                 # client: verifies the server certificate; server: the CA that issued client certificates, for mTLS
# GRPC_TLS_SERVER_NAME=                       # optional; set to the certificate hostname when DOCREADER_ADDR is an IP or does not match the certificate CN
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false         # server side: true requires a client certificate (mTLS)

# gRPC auth token (optional; the client and the server must be given the same value)
# Note: strongly prefer enabling TLS alongside GRPC_AUTH_TOKEN, otherwise the
# token travels over the network in clear text on every RPC. With
# GRPC_TLS_ENABLED=true the client refuses to send the token over an insecure
# connection.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
